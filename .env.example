# NEXORA Environment Configuration (Phase 1 Template)

# Frontend Public Variables (Safe for Browser Exposure)
NEXT_PUBLIC_APP_NAME="NEXORA"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ========================================================
# Phase 2 Backend Variables (NEVER expose to NEXT_PUBLIC_)
# DO NOT COMMIT REAL KEYS TO SOURCE CONTROL
# ========================================================

# Database (PostgreSQL + pgvector)
# DATABASE_URL="postgresql://user:password@localhost:5432/nexora_db"

# LLM Inference: Cloud Providers (Groq, OpenAI) or Local SGLang
# GROQ_API_KEY=""        # Free & fast: https://console.groq.com/keys
# OPENAI_API_KEY=""      # https://platform.openai.com/api-keys
# SGLANG_BASE_URL="http://localhost:30000"
# SGLANG_MODEL="meta-llama/Llama-3.1-8B-Instruct"
# SGLANG_API_KEY=""
# LLM_API_KEY=""

# Voice Synthesis (ElevenLabs)
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""

# External Search (SerpAPI)
# SERPAPI_API_KEY=""

# JWT Authentication
# JWT_SECRET_KEY="replace_with_secure_random_jwt_secret"
# JWT_ALGORITHM="HS256"
