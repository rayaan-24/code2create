# NEXORA Backend Environment Configuration
PROJECT_NAME="NEXORA Intelligent Community Platform API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production, SQLite in local development)
DATABASE_URL="sqlite:///./nexora.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://nexora_admin:nexora_secure_password_123@localhost:5432/nexora_db"

# JWT Security
JWT_SECRET_KEY="generate_a_secure_random_jwt_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Application URL
FRONTEND_URL="http://localhost:3000"

# AI Engine & LLM Inference Configuration
# Option A: Fast cloud API keys (auto-detected)
# GROQ_API_KEY=""        # Free & fast: https://console.groq.com/keys (uses llama-3.3-70b-versatile)
# OPENAI_API_KEY=""      # https://platform.openai.com/api-keys (uses gpt-4o-mini)
# Option B: Local or self-hosted SGLang / vLLM / Ollama server
SGLANG_BASE_URL="http://localhost:30000"
SGLANG_MODEL="meta-llama/Llama-3.1-8B-Instruct"
# SGLANG_API_KEY=""
# LLM_API_KEY=""
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_SEARCH_TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=4096
MAX_TOOL_CALLS=5
AI_REQUEST_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60

# Phase 4 Configuration: Voice & External Web Intelligence
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
VOICE_REQUEST_TIMEOUT=15

SERPAPI_API_KEY=""
SERPAPI_ENGINE="google"
SEARCH_REQUEST_TIMEOUT=10
