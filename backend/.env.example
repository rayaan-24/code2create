# NEXORA Backend Environment Configuration
PROJECT_NAME="NEXORA Intelligent Community Platform API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production, SQLite in local development)
DATABASE_URL="sqlite:///./nexora.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/nexora_db"

# JWT Security
JWT_SECRET_KEY="generate_a_secure_random_jwt_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Application URL
FRONTEND_URL="http://localhost:3000"

# AI Engine & SGLang Configuration (Phase 3)
SGLANG_BASE_URL="http://localhost:30000"
SGLANG_MODEL="meta-llama/Llama-3.1-8B-Instruct"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_SEARCH_TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=4096
MAX_TOOL_CALLS=5
AI_REQUEST_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60

# Future Integration Placeholders (Reserved for Phase 4)
ELEVENLABS_API_KEY=""
SERPAPI_API_KEY=""
